+class Worker:
+    kind='Gemini Web';verified_pipeline=True;worker_id=1;max_translation_targets_per_request=30;last_raw_text=''
+    def __init__(self,mode='valid'):self.mode=mode;self.calls=[];self.translation_calls=0;self.audit_calls=0
+    def reset_conversation(self):pass
+    def generate_external(self,guide,text,*,part_id='',**kw):
+        active=[json.loads(line[len('[TARGET] '):]) for line in text.splitlines() if line.startswith('[TARGET] ')]
+        phase='listener' if guide==v.LISTENER_GUIDE else 'translate' if guide==v.TRANSLATE_GUIDE else 'audit'
+        self.calls.append((phase,[x[0] for x in active]))
+        if phase=='listener':
+            refs={}
+            for key,line,speaker,source,*_ in active:
+                if g.occurrences(source):refs[key]=[dict(REF,source='we',evidence=f's.rpy:{line} | Chloe vient de citer sa mère Emma et elle-même.',members=[] if self.mode=='unknown' else ['ch','em'])]
+            result=dict(part_id=part_id,listeners={x[0]:dict(addressee='p',confidence=.99,evidence=f's.rpy:{x[1]} | Chloe parle à Vincent') for x in active},group_references=refs)
+        elif phase=='translate':
+            self.translation_calls+=1;out=[];renderings={}
+            for key,line,speaker,source,*_ in active:
+                if g.occurrences(source):
+                    bad=self.mode=='wrong_inclusive' and self.translation_calls==1
+                    form='Chúng ta' if bad else 'hai mẹ con'
+                    out.append([key,form+' cũng có kinh nghiệm rồi mà.',''])
+                    renderings[key]=[dict(index=0,text=form,omitted=False)]
+                else:out.append([key,'Mẹ và ⟦RV_SELF⟧ từng làm việc này rồi.',''])
+            result=dict(part_id=part_id,translations=out,group_renderings=renderings)
+        else:
+            self.audit_calls+=1
+            candidates=json.loads(next(line[len('[REVIEW_CANDIDATES] '):] for line in text.splitlines() if line.startswith('[REVIEW_CANDIDATES] ')))
+            result=dict(part_id=part_id,checks=[] if self.mode=='audit_format' and self.audit_calls==1 else
+                        [[r['key'],True,True,'Đối chiếu mẹ Emma + Chloe; loại trừ Vincent; đúng vai và sắc thái.'] for r in candidates])
+            self.assertion=all('Chúng ta' not in r['translation'] for r in candidates)
+            assert self.assertion,'An all-true auditor must not receive locally invalid groups'
+        self.last_raw_text=json.dumps(result,ensure_ascii=False);return result
