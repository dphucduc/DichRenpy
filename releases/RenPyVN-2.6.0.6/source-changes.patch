+    def test_lock_lookup_shared_aliases_and_scope(self):
+        rules=copy.deepcopy(RULES)
+        rules['pairs'].insert(0,dict(speaker='Chloe',listener='Vincent',self='tôi',address='bạn',scope='start',locked=False))
+        self.assertEqual(qa.pair_for(rules,'ch','p','start')['self'],'tớ')
+        self.assertEqual(t._pair_for_row(rules,ROW,locked_only=True)['self'],'tớ')
+        alias_rules=copy.deepcopy(RULES)
+        alias_rules['pairs'][0].update(speaker='Chloe',listener='Vincent')
+        self.assertEqual(t._direct_locked_pair_table(alias_rules,[ROW])[0]['speaker'],'ch')
+        rules['pairs'].append(dict(speaker='Chloe',listener='Vincent',self='anh',address='em',scope='',locked=True))
+        with self.assertRaises(qa.QAError):qa.pair_for(rules,'ch','p','start')
+
+    def test_membership_coverage_evidence_and_inclusion(self):
+        self.assertEqual(g.validate(ROW,DEC,[REF],RULES,[ROW])[0]['members'],['ch','em'])
+        for change in ({'members':[]},{'members':['em','p']},{'members':['ch','missing']},
+                       {'members':['ch','ch']},{'includes_listener':True},{'evidence':'s.rpy:999 | bịa dòng'},
+                       {'index':1},{'evidence':'AI nghĩ vậy'}):
+            with self.subTest(change=change), self.assertRaises(qa.QAError):
+                g.validate(ROW,DEC,[dict(REF,**change)],RULES,[ROW])
+        self.assertEqual(len(g.occurrences('We told [our_name] about our plans.')),2)
+
+    def test_each_occurrence_can_refer_to_a_different_group(self):
+        row=dict(ROW,source='We can help you, then we can all leave.')
+        refs=[REF,dict(REF,index=1,source='we',members=['ch','em','p'],includes_listener=True)]
+        self.assertEqual([r['includes_listener'] for r in g.validate(row,DEC,refs,RULES)],[False,True])
+        with self.assertRaises(qa.QAError):g.validate(row,DEC,[REF],RULES)
+
+    def test_quoted_we_requires_its_own_voice(self):
+        row=dict(ROW,speaker='p',listener='ch',source='She said "We are ready."')
