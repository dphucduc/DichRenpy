+"""Evidence-bound first-person plural references, never guessed from a pair.
+
+An AI record is a reviewable claim, not proof of semantic correctness. Local
+checks ensure complete source coverage, stable identities and declared roles;
+the fresh-chat auditor must still compare that claim with the actual scene.
+"""
+from collections import Counter
+import hashlib
+import json
+import re
+from . import qa
+from .characters import Catalog, NON_PEOPLE, SPECIAL
+
+SCHEMA = 1
+WORDS = re.compile(r'\b(?:we|us|our|ours|ourselves)\b', re.I)
+QUOTES = re.compile(r'"[^"\n]*"|“[^”\n]*”')
+
+
+def occurrences(source):
+    protected = [(a,b) for a,b,_ in qa.protected_spans(source)]
+    quotes = [(m.start(),m.end()) for m in QUOTES.finditer(source)]
+    return [dict(index=i,source=m.group(),start=m.start(),end=m.end(),
+                 quoted=any(a<=m.start()<b for a,b in quotes))
+            for i,m in enumerate(m for m in WORDS.finditer(source)
+                if not any(a<=m.start()<b for a,b in protected))]
+
+
+def input_signature(row, rules, context=''):
+    payload=[row.get(k,'') for k in ('source','speaker','listener','listener_status','label')]
+    payload.extend([rules.get('characters',{}),rules.get('pairs',[]),context])
+    return hashlib.sha256(json.dumps(payload,sort_keys=True,ensure_ascii=False).encode()).hexdigest()
+
+
+def validate(row, decision, references, rules, scene_rows=None):
+    needed=occurrences(str(row.get('source','') or ''))
+    if not needed:return []
+    if not isinstance(references,list) or len(references)!=len(needed):
+        raise qa.QAError('GROUP_REFERENCE_UNCERTAIN: cần xác định riêng nhóm của từng we/us/our trong câu.')
+    catalog=Catalog(rules,(row.get('speaker',''),decision.get('listener','')))
+    known=set(catalog.ids)-set(SPECIAL)-NON_PEOPLE
+    by_index={}
+    for ref in references:
+        if not isinstance(ref,dict) or type(ref.get('index')) is not int or ref['index'] in by_index:
+            raise qa.QAError('Nhóm đại từ sai/trùng index.')
+        by_index[ref['index']]=ref
+    if set(by_index)!=set(range(len(needed))):raise qa.QAError('Nhóm đại từ thiếu/thừa vị trí nguồn.')
+    result=[]
+    for hit in needed:
+        ref=by_index[hit['index']]
+        if str(ref.get('source','')).casefold()!=hit['source'].casefold():
+            raise qa.QAError('Nhóm đại từ không khớp từ nguồn.')
+        members=ref.get('members')
+        if not isinstance(members,list) or not members or not all(isinstance(x,str) for x in members):
+            raise qa.QAError('GROUP_REFERENCE_UNCERTAIN: nhóm chưa có ID thành viên cụ thể.')
+        members=[catalog.canonical(x) for x in members]
+        if len(members)!=len(set(members)) or any(x not in known for x in members):
+            raise qa.QAError('Nhóm chứa ID không tồn tại, sentinel hoặc thành viên trùng.')
+        # Quotes may change the owner of "we". Never silently use the outer voice.
+        voice=ref.get('voice') if hit['quoted'] else row.get('speaker','')
+        if voice not in known or voice not in members:
+            raise qa.QAError('GROUP_REFERENCE_UNCERTAIN: nhóm we phải chứa người phát ngôn; thoại trích dẫn cần voice rõ.')
+        if len(members)<2:
+            raise qa.QAError('GROUP_REFERENCE_UNCERTAIN: we không được tự biến thành đại từ cá nhân.')
+        included=ref.get('includes_listener')
+        if decision.get('status')=='single':
+            expected=catalog.canonical(decision.get('listener','')) in members
+            if type(included) is not bool or included!=expected:
+                raise qa.QAError('Nhóm mâu thuẫn: includes_listener không khớp danh sách thành viên.')
+        elif included is not None:
+            raise qa.QAError('includes_listener phải null khi không có một người nghe cá nhân đã chốt.')
+        evidence=ref.get('evidence')
+        if not isinstance(evidence,str) or not evidence.strip():
+            raise qa.QAError('GROUP_REFERENCE_UNCERTAIN: thiếu căn cứ nhóm từ cảnh.')
+        anchors=re.findall(r'([^\s|]+\.rpy):(\d+)',evidence)
+        if not anchors:
+            raise qa.QAError('Căn cứ nhóm cần chỉ rõ file.rpy:dòng để người dùng đối chiếu.')
+        if scene_rows is not None:
+            locations={(str(r.get('file','')),int(r.get('line',0))) for r in scene_rows}
+            if not any((file,int(line)) in locations for file,line in anchors):
+                raise qa.QAError('Căn cứ nhóm chỉ tới dòng không có trong ngữ cảnh cảnh đang xét.')
+        result.append(dict(index=hit['index'],source=hit['source'],members=members,
+                           voice=voice,includes_listener=included,evidence=evidence))
+    return result
+
+
+def validate_renderings(row, references, renderings):
+    if not references:return []
+    if not isinstance(renderings,list) or len(renderings)!=len(references):
+        raise qa.QAError('Bản dịch thiếu đối chiếu cách gọi từng nhóm we/us/our.')
+    by_index={}
+    for ref in renderings:
+        if not isinstance(ref,dict) or type(ref.get('index')) is not int or ref['index'] in by_index:
+            raise qa.QAError('Cách gọi nhóm sai/trùng index.')
+        by_index[ref['index']]=ref
+    if set(by_index)!={r['index'] for r in references}:raise qa.QAError('Cách gọi nhóm thiếu/thừa vị trí.')
+    used=Counter();result=[]
+    for ref in references:
+        rendering=by_index[ref['index']];text=rendering.get('text');omitted=rendering.get('omitted',False)
+        if type(omitted) is not bool or not isinstance(text,str):raise qa.QAError('Cách gọi nhóm sai kiểu.')
+        if omitted:
+            if text or not str(rendering.get('reason','')).strip():
+                raise qa.QAError('Lược nhóm cần text rỗng và lý do ngữ cảnh; reviewer phải xác nhận không mất nghĩa.')
+        else:
+            if not text.strip() or text not in str(row.get('target','')) or '⟦RV_' in text:
+                raise qa.QAError('Cách gọi nhóm không có trong bản dịch hoặc bị thay bằng đại từ cá nhân.')
+            used[text]+=1
+            if used[text]>str(row.get('target','')).count(text):raise qa.QAError('Cách gọi nhóm không đủ lần xuất hiện.')
+            if ref['includes_listener'] is False and re.search(r'\b(?:chúng ta|hai ta|hai đứa mình)\b',text,re.I):
+                raise qa.QAError('Nhóm loại trừ người nghe nhưng bản dịch lại dùng cách gọi bao gồm người nghe.')
+            if ref['includes_listener'] is True and re.search(r'\b(?:chúng tôi|bọn tôi|tụi tôi|bọn tớ|tụi tớ)\b',text,re.I):
+                raise qa.QAError('Nhóm có người nghe nhưng bản dịch dùng cách gọi loại trừ người nghe.')
+        result.append(dict(index=ref['index'],text=text,omitted=omitted,reason=str(rendering.get('reason',''))))
+    return result
+
+
+def row_error(row,rules):
+    if not occurrences(str(row.get('source','') or '')):return ''
+    try:
+        if row.get('pipeline_group_schema')!=SCHEMA:raise qa.QAError('Nhóm we/us/our chưa được xác định và kiểm tra theo cảnh.')
+        dec=dict(status=row.get('listener_status'),listener=row.get('listener'))
+        refs=validate(row,dec,row.get('pipeline_group_references'),rules)
+        validate_renderings(row,refs,row.get('pipeline_group_renderings'))
+    except qa.QAError as exc:return str(exc)
+    return ''
