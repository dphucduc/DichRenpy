+def _greeting_locked_role_error(source,target,expected_self,expected_addr):
+    """Vietnamese greetings may ADD personal roles absent from English.
+
+    'Hey there' -> 'Cháu chào cô' still asserts both speaker and addressee.
+    Recognize a direct source greeting rather than interpreting every occurrence
+    of 'chào' as personal speech: reported/quoted greetings retain other voices.
+    This validates existing text only; omission and wording remain unrestricted.
+    """
+    quotes=r'["“][^"”]*["”]|‘[^’]*’'
+    src=plain(re.sub(r'\*[^*]*\*',' ',re.sub(quotes,' ',source)))
+    opening=r'^[\s.!?…—–\-]*(?:(?:oh|well|uh|um|ah|yeah|yes|no)[\s,!?.…—–\-]+)*'
+    if not re.search(opening+r'(?:hey|hi|hello|greetings|good\s+(?:morning|afternoon|evening)|nice\s+to\s+meet\s+you|goodbye|bye)\b',src,re.I):
+        return ''
+    raw=re.sub(r'\*[^*]*\*',' ',re.sub(quotes,' ',_visible_text(target)))
+    words='|'.join(map(re.escape,dict.fromkeys(_SUBJECT_SELF_VI+_STRONG_SELF_VI+_STRONG_ADDR_VI)))
+    fillers=r'(?:(?:ôi|ồ|ô|à|dạ|vâng|ừ|ờ|ừm|ơ|oh)\s*[,!?.…—–\-]*\s*)*'
+    predicate=(r'(?:chào|tạm\s+biệt|(?:(?:rất|thật|vô\s+cùng|thật\s+sự|thực\s+sự|cũng)\s+)*'
+               r'(?:vui|mừng|hân\s+hạnh)\s+(?:(?:khi|vì)\s+)?(?:được\s+)?'
+               r'(?:gặp(?:\s+lại)?|làm\s+quen(?:\s+với)?))')
+    pattern=re.compile(r'(?:^|[.!?;…\n])\s*[.…—–\-]*\s*'+fillers+
+        r'(?:(?P<self>'+words+r')(?!\w)\s+)?(?:xin\s+)?'+predicate+r'(?!\w)'
+        r'(?:\s+(?P<addr>'+words+r')(?!\w))?',re.I)
+    for match in pattern.finditer(raw):
+        speaker=match.group('self');listener=match.group('addr')
+        if speaker and speaker.casefold()!=expected_self.casefold():
+            return f'lời chào trực tiếp phải tự xưng {expected_self!r}, nhưng bản dịch dùng {speaker!r}'
+        if listener and listener.casefold()!=expected_addr.casefold():
+            return f'lời chào trực tiếp phải gọi người nghe {expected_addr!r}, nhưng bản dịch dùng {listener!r}'
+    return ''
