+"""Source-anchored role checks; never rewrite translations or guess third people.
+
+Locks name speaker/addressee roles, not a bag of permitted Vietnamese words.
+Lexical anchors let us check ownership independently of clause order. Unknown
+paraphrases and ambiguous co-reference still require the independent reviewer.
+"""
+import re
+SCHEMA=1
+
+def owner_occurrences(source):
+    src=unquoted(source)
+    refs=[]
+    for m in re.finditer(r'\b(my|your)\b',src,re.I):
+        # Exclamations/vocatives are not possessive noun phrases.
+        if re.match(r'\s+(?:god|goodness|gosh)\b|\s+dear\b\s*(?:[,!?.…]|$)',src[m.end():],re.I):continue
+        refs.append({'index':len(refs),'source':m.group().lower(),
+                     'role':'SELF' if m.group().lower()=='my' else 'ADDR'})
+    return refs
+
+def validate_owners(row,pair,records):
+    """Require source-by-source ownership evidence in the ACTUAL saved text.
+
+    This is a contract check, not proof of free-form semantics. Reviewer must
+    still verify noun/meaning alignment and justified natural omission.
+    """
+    from . import qa
+    refs=owner_occurrences(str(row.get('source','')))
+    if not refs or not pair:return []
+    if not isinstance(records,list) or len(records)!=len(refs):raise qa.QAError('Thiếu đối chiếu từng my/your với chủ sở hữu trong bản dịch.')
+    by_index={}
+    for rec in records:
+        if not isinstance(rec,dict) or type(rec.get('index')) is not int or rec['index'] in by_index:raise qa.QAError('Đối chiếu sở hữu sai/trùng index.')
+        by_index[rec['index']]=rec
+    if set(by_index)!=set(range(len(refs))):raise qa.QAError('Đối chiếu sở hữu bỏ sót index.')
+    out=[];target=unquoted(str(row.get('target','')))
+    for ref in refs:
+        rec=by_index[ref['index']];text=rec.get('text');owner=rec.get('owner_text');omitted=rec.get('omitted');reason=rec.get('reason','')
+        expected=str(pair['self' if ref['role']=='SELF' else 'address'])
+        if rec.get('source')!=ref['source'] or rec.get('role')!=ref['role']:raise qa.QAError('Đối chiếu sở hữu đổi vai my/your của nguồn.')
+        if not isinstance(text,str) or not text.strip() or text not in target:raise qa.QAError('Cụm sở hữu đối chiếu không xuất hiện nguyên văn trong bản dịch.')
+        if type(omitted) is not bool or not isinstance(owner,str) or not isinstance(reason,str):raise qa.QAError('Đối chiếu sở hữu sai kiểu dữ liệu.')
+        if omitted:
+            if owner or not reason.strip():raise qa.QAError('Lược chủ sở hữu cần lý do theo cảnh và owner_text rỗng.')
+            if re.search(r'\b(?:của|nhà)\s+(?:'+'|'.join(map(re.escape,qa_words()))+r')(?!\w)',text,re.I):raise qa.QAError('Đã ghi chủ sở hữu trong câu nhưng metadata khai lược.')
+        else:
+            if owner.casefold()!=expected.casefold():raise qa.QAError(f'Chủ sở hữu {ref["source"]} phải dùng {expected!r}; metadata dùng {owner!r}.')
+            # A standalone pronoun elsewhere is insufficient: show the noun
+            # phrase with its explicit owner at the end (của dì / nhà dì / mẹ dì).
+            if not re.search(r'\S.+\s+'+re.escape(owner)+r'(?!\w)\s*$',text,re.I):raise qa.QAError('Cần cụm người/vật sở hữu kèm owner_text ở cuối; không khai từ xưng hô rời rạc.')
+        out.append({**ref,'text':text,'owner_text':'' if omitted else expected,'omitted':omitted,'reason':reason.strip()})
+    return out
+
+def owner_row_error(row,rules):
+    from . import qa
+    if not row.get('pipeline_schema') or row.get('listener_status')!='single' or not owner_occurrences(str(row.get('source',''))):return ''
+    pair=qa.pair_for(rules,row.get('speaker',''),row.get('listener',''),row.get('label',''),locked_only=True)
+    if not pair:return ''
+    try:
+        if row.get('pipeline_owner_schema')!=SCHEMA:raise qa.QAError('Bản dịch chưa có đối chiếu vai sở hữu my/your; cần dịch/kiểm tra lại.')
+        validate_owners(row,pair,row.get('pipeline_owner_renderings'))
+    except qa.QAError as exc:return str(exc)
+    return ''
